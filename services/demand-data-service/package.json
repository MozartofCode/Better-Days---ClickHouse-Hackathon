{
  "name": "hackbetterdays-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Demand-proxy data ingestion (CalICH, CHHS) + Feeding America food bank integration, Postgres operational store, ClickHouse reporting layer.",
  "type": "commonjs",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/api/server.ts",
    "start": "node dist/api/server.js",
    "migrate": "ts-node scripts/migrate.ts",
    "ingest:calich": "ts-node -e \"require('./src/ingest/calich').ingestCalich().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "ingest:chhs": "ts-node -e \"require('./src/ingest/chhsBhCountyProfile').ingestChhsBhCountyProfile().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "ingest:all": "ts-node scripts/ingest-all.ts",
    "etl:clickhouse": "ts-node -e \"require('./src/etl/syncClickhouse').syncClickhouse().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "@clickhouse/client": "^1.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
