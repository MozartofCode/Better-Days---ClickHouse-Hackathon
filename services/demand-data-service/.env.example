# Postgres — operational store (raw ingested rows + Feeding America cache)
DATABASE_URL=postgres://user:password@localhost:5432/hackbetterdays

# ClickHouse — reporting/analytics store, fed by the ETL job, not written to directly
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=hackbetterdays

# Feeding America API, via the parse.bot proxy
# https://parse.bot/marketplace/5d4ee58e-0f17-4eae-953f-d6b940eec137/feedingamerica-org-api
FEEDINGAMERICA_API_KEY=
FEEDINGAMERICA_BASE_URL=https://api.parse.bot/scraper/dcbc6656-4d7d-4ca1-bc88-673b8184b594

PORT=3000
