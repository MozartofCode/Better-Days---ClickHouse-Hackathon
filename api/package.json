{
  "name": "foodbank-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "ingest:calich": "ts-node -e \"require('./src/modules/community-data/ingest/calich').ingestCalich().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "ingest:chhs": "ts-node -e \"require('./src/modules/community-data/ingest/chhsBhCountyProfile').ingestChhsBhCountyProfile().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "ingest:all": "ts-node src/scripts/ingest-all.ts",
    "etl:clickhouse": "ts-node -e \"require('./src/modules/community-data/etl/syncClickhouse').syncClickhouse().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "verify:operations": "ts-node src/scripts/verify-operations.ts",
    "verify:reasoning": "ts-node src/scripts/verify-reasoning.ts",
    "verify:reports": "ts-node src/scripts/verify-report-generation.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
