# Frontend env (Next.js reads .env.local; this file is just the template).
# URL of the api/ backend (see api/README.md).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Groq API key, used by /api/ocr (photo-to-table) and /api/chat (pantry
# analytics chat). Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides; defaults are set in the route files.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
