# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=foodbank
POSTGRES_USER=foodbank
POSTGRES_PASSWORD=change_me

# --- ClickHouse ---
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_DB=foodbank
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# --- API ---
API_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=*

# Shared secret LibreChat's Action config presents via the X-API-Key header
# to call the /api/actions/* endpoints. Generate with: openssl rand -hex 32
# Deprecated in favor of the /mcp server below — kept only until LibreChat is
# cut over to talking MCP directly.
LIBRECHAT_SERVICE_API_KEY=change_me_to_a_long_random_string

# --- MCP OAuth Authorization Server ---
# Public origin this API is reachable at, used as the OAuth issuer and as the
# RFC 8707 resource identifier tokens are bound to. In docker-compose this
# must be the externally-reachable URL, not the internal "api" service name.
# In production (e.g. deployed on Railway) set these to the api's public
# HTTPS URL — Claude and ChatGPT both refuse plain-http remote MCP servers,
# so this must be https:// once it's not localhost.
MCP_ISSUER_URL=http://localhost:4000
MCP_RESOURCE_URL=http://localhost:4000/mcp
MCP_ACCESS_TOKEN_TTL_SECONDS=900
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_AUTH_CODE_TTL_SECONDS=120

# --- Feeding America directory (via parse.bot proxy) ---
# Get this from the teammate who owns it (Ankit). Only /api/community/food-banks*
# routes need it; demand-proxy and ingest routes work without it.
FEEDINGAMERICA_API_KEY=
FEEDINGAMERICA_BASE_URL=https://api.parse.bot/scraper/dcbc6656-4d7d-4ca1-bc88-673b8184b594

# --- LibreChat (Mongo) ---
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
LIBRECHAT_PORT=3080

# LibreChat's own auth/credential-encryption secrets (unrelated to Pana's
# JWT_SECRET above) — required for LibreChat to boot at all.
# JWT secrets: any random string. CREDS_KEY must be 64 hex chars (32 bytes),
# CREDS_IV must be 32 hex chars (16 bytes) — generate with:
#   openssl rand -hex 32   # JWT secrets / CREDS_KEY
#   openssl rand -hex 16   # CREDS_IV
LIBRECHAT_JWT_SECRET=change_me_to_a_long_random_string
LIBRECHAT_JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
LIBRECHAT_CREDS_KEY=change_me_to_64_hex_chars_0123456789abcdef0123456789abcdef01234567
LIBRECHAT_CREDS_IV=change_me_to_32_hex_chars_0123ab

# --- LibreChat's MCP connection (librechat.template.yaml -> mcpServers.pana-food-bank) ---
# Public URLs librechat-render-config.js substitutes into librechat.yaml at
# container start. Locally these default to localhost inside docker-compose.yml
# already — only set them here for a non-default local port, or in production
# where they must be the real public HTTPS URLs (api's Railway URL / wherever
# LibreChat itself is reachable).
PANA_API_PUBLIC_URL=http://localhost:4000
PANA_LIBRECHAT_PUBLIC_URL=http://localhost:3080

# Not a secret you make up — it's issued by the API's own /register endpoint
# (RFC 7591 dynamic client registration). Register once with:
#   curl -X POST http://localhost:4000/register -H "Content-Type: application/json" -d '{
#     "redirect_uris": ["http://localhost:3080/api/mcp/pana-food-bank/oauth/callback"],
#     "token_endpoint_auth_method": "client_secret_post",
#     "grant_types": ["authorization_code","refresh_token"],
#     "response_types": ["code"],
#     "client_name": "LibreChat (Pana)"
#   }'
# then copy client_id/client_secret from the response here.
PANA_MCP_CLIENT_ID=
PANA_MCP_CLIENT_SECRET=

# --- Groq ---
# Used by: LibreChat's Groq endpoint, the frontend's /api/ocr and /api/chat,
# the api/ backend's Ask Your Data narration (api/src/modules/demand-data),
# and api/src/modules/operations/reasoning's dashboard recommendation
# narration. NOT xAI's "Grok" (same name spoken aloud, different product) —
# this is Groq's OpenAI-compatible API, key format starts with gsk_. Get one
# at https://console.groq.com/keys.
# Optional everywhere it's used: unset just means answers/recommendations
# fall back to a plain templated sentence instead of an LLM-written one. The
# underlying numbers are identical either way — they're never computed by the LLM.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
