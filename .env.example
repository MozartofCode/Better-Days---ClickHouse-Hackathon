# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=foodbank
POSTGRES_USER=foodbank
POSTGRES_PASSWORD=change_me

# --- ClickHouse ---
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_DB=foodbank
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# --- API ---
API_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=*

# Shared secret LibreChat's Action config presents via the X-API-Key header
# to call the /api/actions/* endpoints. Generate with: openssl rand -hex 32
LIBRECHAT_SERVICE_API_KEY=change_me_to_a_long_random_string

# --- Feeding America directory (via parse.bot proxy) ---
# Get this from the teammate who owns it (Ankit). Only /api/community/food-banks*
# routes need it; demand-proxy and ingest routes work without it.
FEEDINGAMERICA_API_KEY=
FEEDINGAMERICA_BASE_URL=https://api.parse.bot/scraper/dcbc6656-4d7d-4ca1-bc88-673b8184b594

# --- LibreChat (Mongo) ---
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
LIBRECHAT_PORT=3080

# LibreChat's own auth/session secrets (NOT the same as this API's JWT_SECRET above).
# Generate with:
#   openssl rand -hex 32   # LIBRECHAT_JWT_SECRET, LIBRECHAT_JWT_REFRESH_SECRET, LIBRECHAT_CREDS_KEY
#   openssl rand -hex 16   # LIBRECHAT_CREDS_IV
# CREDS_KEY must be 64 hex chars (32 bytes), CREDS_IV must be 32 hex chars (16 bytes) exactly,
# or LibreChat will fail to start.
LIBRECHAT_JWT_SECRET=change_me
LIBRECHAT_JWT_REFRESH_SECRET=change_me
LIBRECHAT_CREDS_KEY=change_me
LIBRECHAT_CREDS_IV=change_me

# --- Groq (used by LibreChat's Groq endpoint, the frontend's /api/ocr and /api/chat,
# and the api/ backend's Ask Your Data narration — api/src/modules/demand-data) ---
# Get one at https://console.groq.com/keys
# Optional for Ask Your Data: unset just means answers fall back to a plain
# templated sentence instead of an LLM-written one. The underlying numbers are
# identical either way — they're never computed by the LLM.
GROQ_API_KEY=
